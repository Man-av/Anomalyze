# Copy to .env.local and fill in. Every var here is OPTIONAL — the app runs
# with none of them (stats + charts are fully local). Each unlocks one feature.

# AI narration & chat (Google Gemini free tier). Without it, a deterministic
# fallback report is used and chat is disabled.
GEMINI_API_KEY=

# --- Auth: enables per-user analysis history (Clerk) -----------------------
# Sign-in shows up only when the publishable key below is set. Create a Clerk
# app at https://dashboard.clerk.com and paste both keys. Enable Google/GitHub
# under SSO connections in the Clerk dashboard — Clerk brokers the OAuth, so no
# provider secrets live here. Both keys come from the same Clerk app.
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=

# Keeps sign-in/sign-up URLs clean (just /sign-in, no encoded query params)
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
NEXT_PUBLIC_CLERK_SIGN_IN_FALLBACK_REDIRECT_URL=/
NEXT_PUBLIC_CLERK_SIGN_UP_FALLBACK_REDIRECT_URL=/

# --- History storage (Neon / Vercel Postgres) ------------------------------
# Auto-added by Vercel when you attach Postgres. Run schema.sql once. History
# is disabled when unset.
POSTGRES_URL=
